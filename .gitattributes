# Auto detect text files
* text=auto eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Documents
*.pdf binary

# Shell Scripts
*.sh text eol=lf

# Windows Scripts
*.bat text eol=crlf

# Markdown
*.md text